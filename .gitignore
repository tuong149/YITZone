# ==============================================================================
# YITZone Monorepo .gitignore
# Stack: React + Vite + TypeScript (yitzone-client) | Spring Boot + Maven (yitzone-server)
# ==============================================================================

# ------------------------------------------------------------------------------
# Node.js / Frontend (yitzone-client)
# ------------------------------------------------------------------------------
node_modules/
yitzone-client/node_modules/
yitzone-client/dist/
yitzone-client/dist-ssr/
yitzone-client/dev-dist/
yitzone-client/.vite/
yitzone-client/coverage/
.eslintcache
*.tsbuildinfo

# Package manager & runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Java / Spring Boot / Maven (yitzone-server)
# ------------------------------------------------------------------------------
yitzone-server/target/
target/
!.mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Java compiled & packaged artifacts
*.class
*.jar
*.war
*.nar
*.ear
hs_err_pid*
replay_pid*

# Spring Boot local overrides
application-local.yml
application-local.yaml
application-local.properties

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Keys
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local

# Certificates & Private Keys (ECDSA / TLS / Keystores)
*.pem
*.key
*.p12
*.jks
*.keystore

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
docker-compose.override.yml

# ------------------------------------------------------------------------------
# IDEs, Editors & Agent Local Cache
# ------------------------------------------------------------------------------
# IntelliJ IDEA / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Eclipse / STS / NetBeans
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# Vim / Editor swap & backup files
*.swp
*.swo
*~

# Impeccable local config & cache
.impeccable/config.local.json
.impeccable/hook.cache.json

# ------------------------------------------------------------------------------
# Project Documents (only allow SRS, HLD, LLD, USECASE, and UITagline/)
# ------------------------------------------------------------------------------
document/*
!document/SRS_YITZone.md
!document/HLD_YITZone.md
!document/LLD_YITZone.md
!document/USECASE_YITZone.md
!document/UITagline/
!document/UITagline/**

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
