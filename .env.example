# Environment Variables Template for YITZone (HLD 6.1 & 6.2)
SPRING_PROFILES_ACTIVE=dev

# MongoDB Single-Node Replica Set
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/yitzone?replicaSet=rs0

# Redis 7.4
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Object Storage (pgsty/silo - S3 Compatible)
SILO_ACCESS_KEY=yitzone_dev_key
SILO_SECRET_KEY=yitzone_dev_secret
YITZONE_STORAGE_ENDPOINT=http://localhost:9000
YITZONE_STORAGE_PUBLIC_BUCKET=yitzone-public
YITZONE_STORAGE_PRIVATE_BUCKET=yitzone-private

# ClamAV Daemon
YITZONE_CLAMAV_HOST=localhost
YITZONE_CLAMAV_PORT=3310

# JWT & ECDSA P-256 Keys
YITZONE_JWT_SECRET=change-me-in-production-min-64-chars-yitzone-secret-key-2026

# University OIDC SSO (Entra ID / Google Workspace)
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_ISSUER_URI=https://accounts.google.com

# AI Gateway (Spring AI / OpenAI-compatible / Gemini / Ollama)
YITZONE_AI_PROVIDER=gemini
YITZONE_AI_API_KEY=your-llm-api-key
YITZONE_AI_MONTHLY_BUDGET_USD=25.00

# Payment Webhook (SePay or PayOS)
YITZONE_PAYMENT_WEBHOOK_SECRET=your-hmac-sha256-secret

# Web Push VAPID
YITZONE_VAPID_PUBLIC_KEY=
YITZONE_VAPID_PRIVATE_KEY=
